#!/bin/sh
firewall_config=$(uci -q show firewall) || exit 1
sec=$(printf '%s\n' "$firewall_config" |
    sed -n "/^firewall\.[^.]*\.name='wan'$/ { s/^firewall\.//; s/\.name=.*//; p; q; }") || exit 1
if [ -n "$sec" ] && [ "$sec" != 'wan' ]; then
    uci rename "firewall.$sec=wan" || exit 1
fi

[ "${1:-}" = '--defaults' ] && exit 0

uci commit firewall || exit 1
/etc/init.d/firewall reload
