#!/bin/sh
# Broadcast the 5 GHz access point on lan (radio1, wifi-iface
# 'default_radio1' as generated by `wifi config`), left disabled.
# Enable with: uci set wireless.default_radio1.disabled=0

set -e

SSID='tr3000_5G'

uci -q set wireless.radio1.country='CN'
uci -q set wireless.radio1.htmode='HE160'

uci -q set wireless.default_radio1=wifi-iface
uci -q set wireless.default_radio1.device='radio1'
uci -q set wireless.default_radio1.mode='ap'
uci -q set wireless.default_radio1.network='lan'
uci -q set wireless.default_radio1.ssid="$SSID"
uci -q set wireless.default_radio1.encryption='none'
uci -q set wireless.default_radio1.disabled='0'

# First-boot defaults are committed by OpenWrt's boot script.
[ "${1:-}" = '--defaults' ] && exit 0

uci commit wireless
wifi reload
