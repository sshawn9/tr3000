libnftnl: regenerate autotools files before configure

The fullcone component patch (patches/libnftnl/001-*) adds
src/expr/fullcone.c to src/Makefile.am. The release tarball ships a
Makefile.in generated by automake 1.17, so automake's rebuild rule then
demands that exact version, which the OpenWrt host toolchain does not
provide. PKG_FIXUP:=autoreconf regenerates the build system with the
host autotools instead, which is what ImmortalWrt's libnftnl Makefile
does as well.

--- a/package/libs/libnftnl/Makefile
+++ b/package/libs/libnftnl/Makefile
@@ -20,6 +20,7 @@
 PKG_LICENSE:=GPL-2.0-or-later
 PKG_LICENSE_FILES:=COPYING
 
+PKG_FIXUP:=autoreconf
 PKG_INSTALL:=1
 PKG_BUILD_PARALLEL:=1
 PKG_BUILD_FLAGS:=lto
