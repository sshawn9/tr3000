# Note: on mediatek/filogic the target kernel config builds EXT4_FS, F2FS_FS,
# SCSI, SCSI_COMMON and BLK_DEV_SD in (=y), so kmod-fs-ext4, kmod-fs-f2fs and
# the auto-selected kmod-scsi-core are empty meta packages here. They are kept
# to state the intent and stay correct if upstream turns them back into modules.
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_exfat-fsck=y
