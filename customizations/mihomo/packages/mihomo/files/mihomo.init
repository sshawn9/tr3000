#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/mihomo
HOME_DIR=/etc/mihomo

start_service() {
	local output

	# Exit the init script on failure: returning would let rc.common submit an
	# empty instance list and stop an existing service during reload.
	[ -f "$HOME_DIR/config.yaml" ] || {
		logger -t mihomo -p daemon.err "config file not found: $HOME_DIR/config.yaml"
		exit 1
	}
	if ! output=$("$PROG" -d "$HOME_DIR" -t 2>&1); then
		printf '%s\n' "config test failed: $HOME_DIR/config.yaml" "$output" |
			logger -t mihomo -p daemon.err
		exit 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" -d "$HOME_DIR"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	# procd compares this file on reload and restarts the process if it changed.
	procd_set_param file "$HOME_DIR/config.yaml"
	procd_set_param limits nofile="65536 65536"
	# Soft limit for Go-managed memory, not a hard limit on total process memory.
	# GOGC=200 can reduce GC work at the cost of higher memory use.
	procd_set_param env GOMEMLIMIT=192MiB GOGC=200
	procd_close_instance
}
